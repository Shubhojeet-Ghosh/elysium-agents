{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Elysium Server",
      "type": "shell",
      "command": ".venv/Scripts/python main.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Clear Redis (Docker)",
      "type": "shell",
      "command": "docker exec redis redis-cli FLUSHALL",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
