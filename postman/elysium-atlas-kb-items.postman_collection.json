    {
      "name": "Files",
      "item": [
        {
          "name": "Create File (draft shell)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.kb_id) {",
                  "  pm.collectionVariables.set('file_kb_id', json.kb_id);",
                  "  pm.collectionVariables.set('kb_id', json.kb_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_name\": \"product-guide.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/elysium-agents/elysium-atlas/kb-items/v1/create-file",
              "host": ["{{base_url}}"],
              "path": [
                "elysium-agents",
                "elysium-atlas",
                "kb-items",
                "v1",
                "create-file"
              ]
            },
            "description": "Step 1 of file upload: creates a draft item and returns `kb_id`."
          },
          "response": []
        },
        {
          "name": "Generate Presigned URLs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.presigned_urls && json.presigned_urls[0] && json.presigned_urls[0].s3_key) {",
                  "  pm.collectionVariables.set('file_key', json.presigned_urls[0].s3_key);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kb_id\": \"{{file_kb_id}}\",\n  \"files\": [\n    {\n      \"file_name\": \"product-guide.pdf\",\n      \"filetype\": \"application/pdf\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/elysium-agents/elysium-atlas/kb-items/v1/generate-presigned-urls",
              "host": ["{{base_url}}"],
              "path": [
                "elysium-agents",
                "elysium-atlas",
                "kb-items",
                "v1",
                "generate-presigned-urls"
              ]
            },
            "description": "Step 2: get S3 presigned upload URL(s). Upload file to S3 with PUT outside Postman (or use presigned URL in a separate request)."
          },
          "response": []
        },
        {
          "name": "Finalize File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kb_id\": \"{{file_kb_id}}\",\n  \"file_key\": \"{{file_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/elysium-agents/elysium-atlas/kb-items/v1/finalize-file",
              "host": ["{{base_url}}"],
              "path": [
                "elysium-agents",
                "elysium-atlas",
                "kb-items",
                "v1",
                "finalize-file"
              ]
            },
            "description": "Step 3: after S3 upload, finalize same `kb_id` (Option A replace) and trigger indexing."
          },
          "response": []
        },
        {
