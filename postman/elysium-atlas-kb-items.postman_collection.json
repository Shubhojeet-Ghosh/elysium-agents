          },
          "response": []
        },
        {
          "name": "Delete File",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kb_id\": \"{{file_kb_id}}\"\n}",
              "options": {
                "raw": {
